# ==============================================================================
# Yuntu Travel Planning Engine - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://yuntu:yuntupassword@localhost:5432/yuntu_travel

# ------------------------------------------------------------------------------
# LLM Providers Configuration (One global key is enough to start)
# ------------------------------------------------------------------------------
# You can use DeepSeek, Google Gemini, OpenAI, or any OpenAI-compatible gateway.
# Leave per-role keys blank to automatically reuse your global key across roles.

# Option A: DeepSeek (Recommended quickstart)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Option B: Google Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=your_gemini_api_key_here

# Option C: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Optional Per-Role Overrides (e.g. mix Gemini route planner + DeepSeek writer,
# or point *_BASE_URL at a custom OpenAI-compatible gateway)
# SELECTOR_PROVIDER=deepseek
# SELECTOR_MODEL=deepseek-chat
# SELECTOR_API_KEY=
# SELECTOR_BASE_URL=

# ROUTE_PLANNER_PROVIDER=gemini
# ROUTE_PLANNER_MODEL=gemini-2.5-flash
# ROUTE_PLANNER_API_KEY=
# ROUTE_PLANNER_BASE_URL=

# WRITER_PROVIDER=deepseek
# WRITER_MODEL=deepseek-chat
# WRITER_API_KEY=
# WRITER_BASE_URL=

# INTENT_PROVIDER=deepseek
# INTENT_MODEL=deepseek-chat
# INTENT_API_KEY=
# INTENT_BASE_URL=

# ------------------------------------------------------------------------------
# v0.15.1 Generation & Route Planning Features
# ------------------------------------------------------------------------------
ROUTE_PLANNER_ENABLED=true
WRITER_PROMPT_VERSION=article
RESULT_PLANNED_TIME_ENABLED=true
LLM_REVIEW_ENABLED=false
SPECULATIVE_DS_STANDBY_ENABLED=false
V012_TRIP_CREATION_ENABLED=true
V012_TRIP_WORKER_ENABLED=true

# ------------------------------------------------------------------------------
# Map & Geo Services (AMap / 高德开放平台)
# ------------------------------------------------------------------------------
# Required for Geocoding & Route Commute Distance Optimization
AMAP_API_KEY=your_amap_web_api_key_here
AMAP_ROUTE_ENABLED=true

# ------------------------------------------------------------------------------
# Background Workers & Task Concurrency
# ------------------------------------------------------------------------------
TRIP_WORKER_ENABLED=true
TRIP_WORKER_CONCURRENCY=3
TRIP_JOB_TIMEOUT_SECONDS=180
PUBLIC_API_IP_ALLOWLIST=127.0.0.1,::1
